# ==============================================
# BECHAKENA+ ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================

# SUPABASE (PUBLIC - Client Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SUPABASE (SERVER-ONLY - SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# IMGBB IMAGE HOSTING (SERVER-ONLY - SECRET)
IMGBB_API_KEY=your-imgbb-api-key

# ADMIN AUTH (SERVER-ONLY - SECRET)
ADMIN_JWT_SECRET=generate-a-strong-random-secret-key
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=your-secure-password

# ADSTERRA / SITE (PUBLIC)
NEXT_PUBLIC_ADSTERRA_ENABLED=true
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
